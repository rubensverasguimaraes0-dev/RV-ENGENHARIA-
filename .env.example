# Supabase — crie o projeto em https://supabase.com e copie as chaves em
# Project Settings > API. Rode as migrations de supabase/migrations na ordem.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
